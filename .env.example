# Algorand TestNet (AlgoNode public endpoints -- no token needed)
ALGOD_ADDRESS=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
INDEXER_ADDRESS=https://testnet-idx.algonode.cloud
INDEXER_TOKEN=

# Service account: receives x402 payments AND signs audit-note transactions.
# Generate one with AlgoKit or `goal account new`, then fund it at
# https://bank.testnet.algorand.network/
# NEVER commit a real mnemonic. Use a secrets manager in production.
SERVICE_MNEMONIC="word1 word2 word3 ... word25"

# Price to access the protected resource
PRICE_MICROALGOS=100000

# Local audit index (cache only -- on-chain note is the source of truth)
AUDIT_DB_PATH=audit.db

# Reject payment txns older than this many seconds
PAYMENT_TXN_MAX_AGE_SECONDS=3600
