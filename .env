# ============================================================
# PS0405 - Algorand TestNet Configuration
# ============================================================

# ------------------------------------------------------------
# Algorand TestNet - AlgoNode public endpoints
# No API token required
# ------------------------------------------------------------

ALGOD_ADDRESS=https://testnet-api.algonode.cloud
ALGOD_TOKEN=

INDEXER_ADDRESS=https://testnet-idx.algonode.cloud
INDEXER_TOKEN=


# ------------------------------------------------------------
# Service Account
# ------------------------------------------------------------
# Receives x402 payments
# Signs the audit-note transactions
#
# IMPORTANT:
# Put your REAL Service account 25-word mnemonic here.
# NEVER publish this file or commit it to GitHub.
# ------------------------------------------------------------

SERVICE_MNEMONIC=fee imitate crack moral inside model category derive quick program fabric keen sound all wreck pact address area beef ugly body poet remember about rug



# ------------------------------------------------------------
# Payer Account
# ------------------------------------------------------------
# Used by demo_client.py to make the TestNet payment.
#
# This must be a DIFFERENT account from the Service account.
#
# IMPORTANT:
# Put your REAL Payer account 25-word mnemonic here.
# NEVER publish this file or commit it to GitHub.
# ------------------------------------------------------------

PAYER_MNEMONIC=exact used night distance naive gadget punch define tourist vibrant word exchange lizard practice cat ridge pelican window harbor member alien until soldier ability present


# ------------------------------------------------------------
# x402 Payment Price
# ------------------------------------------------------------
# 100000 microAlgos = 0.1 ALGO
# ------------------------------------------------------------

PRICE_MICROALGOS=100000


# ------------------------------------------------------------
# Local Audit Database
# ------------------------------------------------------------
# SQLite cache.
# The Algorand blockchain remains the source of truth.
# ------------------------------------------------------------

AUDIT_DB_PATH=audit.db


# ------------------------------------------------------------
# Payment Transaction Age Limit
# ------------------------------------------------------------
# Reject payments older than 1 hour.
# 3600 seconds = 1 hour
# ------------------------------------------------------------

PAYMENT_TXN_MAX_AGE_SECONDS=3600